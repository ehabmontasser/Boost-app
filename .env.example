# Copy these into Vercel > Project > Settings > Environment Variables (never commit real values).
# Supabase > Project Settings > Database > Connection string > Transaction pooler (replace [YOUR-PASSWORD]).
DATABASE_URL=postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
# Password for the account manager login (choose any strong password).
ADMIN_PASSWORD=
# Random string used to sign login cookies (for example the output of: openssl rand -hex 32).
SESSION_SECRET=
# Anthropic API key (console.anthropic.com). Set a monthly spend cap on the key.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-sonnet-5-5.
ANTHROPIC_MODEL=
